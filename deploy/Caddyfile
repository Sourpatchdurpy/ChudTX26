# Copy to /etc/caddy/Caddyfile on the Vultr VM, then: sudo systemctl reload caddy
# Caddy gets HTTPS certificates automatically and proxies WebSockets with no extra config.
#
# STEP A (right away): plain HTTP on the VM's IP address. Phones open http://<VM_IP>
# STEP B (once amuse-us.tech has an A record pointing at the VM and `dig +short amuse-us.tech` shows the IP):
#         delete the ":80 { ... }" block, uncomment the domain block, reload.

:80 {
	encode zstd gzip
	handle /socket.io/* {
		reverse_proxy localhost:4000
	}
	handle /health {
		reverse_proxy localhost:4000
	}
	handle {
		reverse_proxy localhost:3000
	}
}

