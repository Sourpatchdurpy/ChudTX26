# Copy to /etc/caddy/Caddyfile on the Vultr VM, then: systemctl reload caddy
# Caddy gets HTTPS certificates automatically, redirects http → https, and proxies
# WebSockets with no extra config. Needs amuse-us.tech's A records pointing at the VM.
#
# Before the domain worked we used a plain ":80 { ... }" block on the VM's IP instead.

amuse-us.tech, www.amuse-us.tech {
	encode zstd gzip

	# Game server (Socket.IO + health check).
	handle /socket.io/* {
		reverse_proxy localhost:4000
	}
	handle /health {
		reverse_proxy localhost:4000
	}

	# Frontend: the Vite build in /opt/game/apps/web/dist (built by deploy/deploy.sh).
	# Unknown paths fall back to index.html so links like /join/ABCD work.
	handle {
		root * /opt/game/apps/web/dist
		try_files {path} /index.html
		file_server
	}
}
