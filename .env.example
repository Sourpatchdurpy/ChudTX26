# ── Game server (apps/server reads this file from the repo root) ──
PORT=4000
# Comma-separated. Production is same-origin behind Caddy, so this only matters in dev.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# stub = canned AI, no API key needed. muse = real Meta Muse AI.
AI_MODE=stub

# Meta Model API (redeem the $50 credits via Meta's intake form). Never commit a real key.
MODEL_API_KEY=
MUSE_MODEL=muse-spark-1.3
MUSE_TIMEOUT_MS=12000
# Spending guardrails (each teammate only has $50 of credit). Calls fail fast past these, and the AI uses fallback lines.
MUSE_BUDGET_USD=5
MUSE_MAX_CALLS_PER_MIN=60
# How long to reuse web-search world context across rooms (ms).
WORLD_CONTEXT_TTL_MS=3600000

# Messages appear immediately; each sender waits this long before sending again (ms).
CHAT_COOLDOWN_MS=5000
# Multiply every phase timer, e.g. 0.5 while testing.
TIMER_SCALE=1

# ── Web (put this one in apps/web/.env.local instead) ──
# Dev: http://localhost:4000   Production: leave empty (same origin).
# NEXT_PUBLIC_SERVER_URL=http://localhost:4000
