{
  "name": "chudtx26",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "ai"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev:server\" \"npm run dev:web\"",
    "dev:web": "npm run dev -w @game/web",
    "dev:server": "npm run dev -w @game/server",
    "build": "npm run build -w @game/web",
    "build:web": "npm run build -w @game/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "ai:lab": "npm run lab -w @game/ai --",
    "test:ai": "npm run test -w @game/ai",
    "test:server": "npm run test -w @game/server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
