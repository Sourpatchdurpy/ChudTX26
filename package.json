{
  "name": "chudtx26",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "ai"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev:server\" \"npm run dev:web\"",
    "dev:web": "vite --host 127.0.0.1 --port 3000 --strictPort",
    "dev:server": "npm run dev -w @game/server",
    "build": "npm run typecheck && vite build",
    "build:web": "npm run build",
    "typecheck": "npm run typecheck:web && npm run typecheck --workspaces --if-present",
    "typecheck:web": "tsc --noEmit -p tsconfig.json",
    "ai:lab": "npm run lab -w @game/ai --",
    "test:ai": "npm run test -w @game/ai",
    "test:server": "npm run test -w @game/server"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "4.8.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.12"
  }
}
